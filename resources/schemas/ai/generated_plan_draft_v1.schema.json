{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planeaciones.local/schemas/generated-plan-draft-v1.schema.json",
  "title": "GeneratedPlanDraftV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "title",
    "purpose",
    "learning_goals",
    "methodology",
    "transversal_connections",
    "sessions",
    "assessment_plan",
    "resources",
    "adaptation_notes"
  ],
  "properties": {
    "contract_version": {
      "const": "generated_plan_draft_v1"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "project_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "problem_or_interest": {
      "type": [
        "string",
        "null"
      ]
    },
    "scenario": {
      "type": [
        "string",
        "null"
      ]
    },
    "learning_goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "rationale",
        "phases"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "transversal_connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "field_codes"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "field_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/session"
      }
    },
    "assessment_plan": {
      "$ref": "#/$defs/assessmentPlan"
    },
    "resources": {
      "$ref": "#/$defs/resources"
    },
    "adaptation_notes": {
      "$ref": "#/$defs/adaptationNotes"
    }
  },
  "$defs": {
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instruction",
        "teacher_action",
        "student_action",
        "organization",
        "materials",
        "expected_evidence",
        "assessment_checks"
      ],
      "properties": {
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "teacher_action": {
          "type": "string",
          "minLength": 1
        },
        "student_action": {
          "type": "string",
          "minLength": 1
        },
        "organization": {
          "enum": [
            "whole_group",
            "individual",
            "pairs",
            "small_groups",
            "mixed"
          ]
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assessment_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "moment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "minutes",
        "activities"
      ],
      "properties": {
        "type": {
          "enum": [
            "inicio",
            "desarrollo",
            "cierre"
          ]
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 480
        },
        "activities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/activity"
          }
        }
      }
    },
    "sessionAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria",
        "evidence",
        "instrument_ids",
        "feedback_strategy"
      ],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "instrument_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^I[0-9]{2}$"
          }
        },
        "feedback_strategy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "date",
        "title",
        "estimated_minutes",
        "methodology_phase",
        "specific_goal",
        "field_codes",
        "content_codes",
        "pda_codes",
        "axis_codes",
        "moments",
        "formative_assessment",
        "differentiation",
        "homework_or_extension",
        "teacher_notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^S[0-9]{2,3}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "estimated_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 480
        },
        "methodology_phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "specific_goal": {
          "type": "string",
          "minLength": 1
        },
        "field_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "content_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "pda_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "axis_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "moments": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/moment"
          }
        },
        "formative_assessment": {
          "$ref": "#/$defs/sessionAssessment"
        },
        "differentiation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "support",
            "challenge",
            "accessibility"
          ],
          "properties": {
            "support": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "challenge": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "accessibility": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "homework_or_extension": {
          "type": [
            "string",
            "null"
          ]
        },
        "teacher_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "purpose",
        "criteria",
        "applies_to_sessions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^I[0-9]{2}$"
        },
        "type": {
          "enum": [
            "checklist",
            "rubric",
            "rating_scale",
            "observation_record",
            "student_product",
            "exit_questions",
            "other"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "applies_to_sessions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^S[0-9]{2,3}$"
          }
        },
        "scale": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "assessmentPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approach",
        "diagnostic",
        "ongoing",
        "closure",
        "instruments"
      ],
      "properties": {
        "approach": {
          "const": "formative"
        },
        "diagnostic": {
          "type": [
            "string",
            "null"
          ]
        },
        "ongoing": {
          "type": "string",
          "minLength": 1
        },
        "closure": {
          "type": "string",
          "minLength": 1
        },
        "instruments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/instrument"
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical_materials",
        "digital_resources",
        "provided_references"
      ],
      "properties": {
        "physical_materials": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "digital_resources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provided_references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "adaptationNotes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "based_on_group_profile",
        "assumptions",
        "missing_information"
      ],
      "properties": {
        "based_on_group_profile": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_information": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}