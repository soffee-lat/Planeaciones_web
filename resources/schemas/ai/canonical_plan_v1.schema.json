{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planeaciones.local/schemas/canonical-plan-v1.schema.json",
  "title": "CanonicalPlanV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "planning",
    "context",
    "curricular_alignment",
    "pedagogical_design",
    "sessions",
    "assessment_plan",
    "resources",
    "adaptation_notes"
  ],
  "properties": {
    "schema_version": {
      "const": "canonical_plan_v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planning_request_id",
        "input_version_id",
        "input_revision",
        "selection_revision",
        "curriculum_checksum",
        "generation_contract_version"
      ],
      "properties": {
        "planning_request_id": {
          "type": "integer",
          "minimum": 1
        },
        "input_version_id": {
          "type": "integer",
          "minimum": 1
        },
        "input_revision": {
          "type": "integer",
          "minimum": 0
        },
        "selection_revision": {
          "type": "integer",
          "minimum": 0
        },
        "curriculum_checksum": {
          "type": "string",
          "minLength": 1
        },
        "commercial_snapshot_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "generation_contract_version": {
          "const": "generated_plan_draft_v1"
        }
      }
    },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "project_name",
        "topic",
        "planning_type",
        "starts_on",
        "ends_on",
        "session_minutes",
        "session_count"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "project_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "topic": {
          "type": [
            "string",
            "null"
          ]
        },
        "planning_type": {
          "enum": [
            "weekly",
            "project",
            "didactic_sequence",
            "custom"
          ]
        },
        "starts_on": {
          "type": "string",
          "format": "date"
        },
        "ends_on": {
          "type": "string",
          "format": "date"
        },
        "session_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 480
        },
        "session_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": true
    },
    "curricular_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "curriculum",
        "phase",
        "grade",
        "fields",
        "contents",
        "pdas",
        "articulating_axes",
        "coverage"
      ],
      "properties": {
        "curriculum": {
          "type": "object",
          "required": [
            "code",
            "name",
            "version",
            "checksum"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "checksum": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "phase": {
          "type": "object",
          "required": [
            "code",
            "name"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "grade": {
          "type": "object",
          "required": [
            "code",
            "name"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "code",
              "name"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "contents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "code",
              "title",
              "full_text",
              "field_code"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "full_text": {
                "type": "string"
              },
              "field_code": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "pdas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "code",
              "full_text",
              "content_code",
              "grade_code"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "full_text": {
                "type": "string"
              },
              "content_code": {
                "type": "string"
              },
              "grade_code": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "articulating_axes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "name"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pda_code",
              "session_ids"
            ],
            "properties": {
              "pda_code": {
                "type": "string"
              },
              "session_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^S[0-9]{2,3}$"
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "pedagogical_design": {
      "type": "object",
      "additionalProperties": true
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/session"
      }
    },
    "assessment_plan": {
      "$ref": "#/$defs/assessmentPlan"
    },
    "resources": {
      "$ref": "#/$defs/resources"
    },
    "adaptation_notes": {
      "$ref": "#/$defs/adaptationNotes"
    }
  },
  "$defs": {
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instruction",
        "teacher_action",
        "student_action",
        "organization",
        "materials",
        "expected_evidence",
        "assessment_checks"
      ],
      "properties": {
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "teacher_action": {
          "type": "string",
          "minLength": 1
        },
        "student_action": {
          "type": "string",
          "minLength": 1
        },
        "organization": {
          "enum": [
            "whole_group",
            "individual",
            "pairs",
            "small_groups",
            "mixed"
          ]
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assessment_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "moment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "minutes",
        "activities"
      ],
      "properties": {
        "type": {
          "enum": [
            "inicio",
            "desarrollo",
            "cierre"
          ]
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 480
        },
        "activities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/activity"
          }
        }
      }
    },
    "sessionAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria",
        "evidence",
        "instrument_ids",
        "feedback_strategy"
      ],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "instrument_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^I[0-9]{2}$"
          }
        },
        "feedback_strategy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "date",
        "title",
        "estimated_minutes",
        "methodology_phase",
        "specific_goal",
        "field_codes",
        "content_codes",
        "pda_codes",
        "axis_codes",
        "moments",
        "formative_assessment",
        "differentiation",
        "homework_or_extension",
        "teacher_notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^S[0-9]{2,3}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "estimated_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 480
        },
        "methodology_phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "specific_goal": {
          "type": "string",
          "minLength": 1
        },
        "field_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "content_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "pda_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "axis_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "moments": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/moment"
          }
        },
        "formative_assessment": {
          "$ref": "#/$defs/sessionAssessment"
        },
        "differentiation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "support",
            "challenge",
            "accessibility"
          ],
          "properties": {
            "support": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "challenge": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "accessibility": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "homework_or_extension": {
          "type": [
            "string",
            "null"
          ]
        },
        "teacher_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "purpose",
        "criteria",
        "applies_to_sessions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^I[0-9]{2}$"
        },
        "type": {
          "enum": [
            "checklist",
            "rubric",
            "rating_scale",
            "observation_record",
            "student_product",
            "exit_questions",
            "other"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "applies_to_sessions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^S[0-9]{2,3}$"
          }
        },
        "scale": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "assessmentPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approach",
        "diagnostic",
        "ongoing",
        "closure",
        "instruments"
      ],
      "properties": {
        "approach": {
          "const": "formative"
        },
        "diagnostic": {
          "type": [
            "string",
            "null"
          ]
        },
        "ongoing": {
          "type": "string",
          "minLength": 1
        },
        "closure": {
          "type": "string",
          "minLength": 1
        },
        "instruments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/instrument"
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical_materials",
        "digital_resources",
        "provided_references"
      ],
      "properties": {
        "physical_materials": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "digital_resources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provided_references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "adaptationNotes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "based_on_group_profile",
        "assumptions",
        "missing_information"
      ],
      "properties": {
        "based_on_group_profile": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_information": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}