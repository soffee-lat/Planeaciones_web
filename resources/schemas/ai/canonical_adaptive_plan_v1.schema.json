{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planeaciones.local/schemas/canonical-adaptive-plan-v1.schema.json",
  "title": "CanonicalAdaptivePlanV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "planning",
    "context",
    "curricular_alignment",
    "pedagogical_design"
  ],
  "properties": {
    "schema_version": {"const": "canonical_adaptive_plan_v1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planning_request_id",
        "input_version_id",
        "input_revision",
        "selection_revision",
        "curriculum_checksum",
        "generation_contract_version"
      ],
      "properties": {
        "planning_request_id": {"type": "integer", "minimum": 1},
        "input_version_id": {"type": "integer", "minimum": 1},
        "input_revision": {"type": "integer", "minimum": 0},
        "selection_revision": {"type": "integer", "minimum": 0},
        "curriculum_checksum": {"type": "string", "minLength": 1},
        "commercial_snapshot_version": {"type": ["integer", "null"], "minimum": 1},
        "generation_contract_version": {"const": "adaptive_template_generation_v1"},
        "format_version_id": {"type": "integer", "minimum": 1}
      }
    },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "project_name", "topic", "planning_type", "starts_on", "ends_on", "session_minutes"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "project_name": {"type": ["string", "null"]},
        "topic": {"type": ["string", "null"]},
        "planning_type": {"const": "custom"},
        "starts_on": {"type": "string", "format": "date"},
        "ends_on": {"type": "string", "format": "date"},
        "session_minutes": {"type": ["integer", "null"], "minimum": 1, "maximum": 480}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": true
    },
    "curricular_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["curriculum", "phase", "grade", "fields", "contents", "pdas", "articulating_axes", "coverage"],
      "properties": {
        "curriculum": {"type": "object", "additionalProperties": true},
        "phase": {"type": "object", "additionalProperties": true},
        "grade": {"type": "object", "additionalProperties": true},
        "fields": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": true}},
        "contents": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": true}},
        "pdas": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": true}},
        "articulating_axes": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "coverage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pda_code", "explanation"],
            "properties": {
              "pda_code": {"type": "string", "minLength": 1},
              "explanation": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "pedagogical_design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "learning_goals", "assessment_strategy", "adaptation_considerations"],
      "properties": {
        "purpose": {"type": "string", "minLength": 1},
        "learning_goals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "assessment_strategy": {"type": "string", "minLength": 1},
        "adaptation_considerations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "template_fields": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
