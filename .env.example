APP_NAME=Planeaciones
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=planeaciones
DB_USERNAME=planeaciones
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Pipeline IA. Fase 4 usa manual; API se habilita al integrar proveedor real.
AI_MODE=manual
AI_GENERATION_PROMPT_KEY=planning.generation
AI_AUDIT_PROMPT_KEY=planning.audit
AI_MANUAL_DISK=private
AI_MANUAL_PREFIX=ai/manual
AI_OUTBOX_LEASE_SECONDS=120
AI_OUTBOX_RETRY_SECONDS=30
AI_CORRECTION_PROMPT_KEY=planning.correction
AI_INTERNAL_CORRECTION_MAX_ROUNDS=2
AI_INTERNAL_CORRECTION_MAX_KNOWN_COST=
AI_INTERNAL_CORRECTION_COST_CURRENCY=
AI_HUMAN_REVIEW_CORRECTION_MAX_ROUNDS=3

# Document rendering
DOCUMENTS_DISK=private
DOCUMENTS_PREFIX=documents
DOCUMENTS_QUEUE=documents
DOCUMENT_RESULT_RETENTION_DAYS=365

# Notificaciones operativas
BUSINESS_TIMEZONE=America/Mexico_City
OPERATIONAL_NOTIFICATION_RENEWAL_DAYS=7
OPERATIONAL_NOTIFICATION_EMAIL_LEASE_SECONDS=120
OPERATIONAL_NOTIFICATION_EMAIL_RETRY_SECONDS=60
